VITE_API_URL=https://api.example.com
# Add other VITE_ prefixed environment variables here, e.g.:
# VITE_AUTH_CLIENT_ID=your_client_id
# VITE_SOME_KEY=...

# Supabase Postgres connection for the Express server.
# Get this from Supabase Dashboard > Connect > Connection string.
# Prefer the Transaction pooler connection string for serverless/local app usage.
# Do NOT commit the real password or connection string.
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true
# DATABASE_URL is also supported as an alternative to SUPABASE_DB_URL.
DATABASE_URL=
JWT_SECRET=change_this_to_a_secret
JWT_EXP=7d
