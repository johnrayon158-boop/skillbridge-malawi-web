VITE_API_URL=https://api.example.com
# Add other VITE_ prefixed environment variables here, e.g.:
# VITE_AUTH_CLIENT_ID=your_client_id
# VITE_SOME_KEY=...

# Database connection for local development (Postgres)
# Example: postgres://username:password@localhost:5432/skillbridge_dev
# Do NOT commit real credentials. Use your environment to populate.
DATABASE_URL=postgres://user:pass@localhost:5432/skillbridge_dev
JWT_SECRET=change_this_to_a_secret
JWT_EXP=7d
